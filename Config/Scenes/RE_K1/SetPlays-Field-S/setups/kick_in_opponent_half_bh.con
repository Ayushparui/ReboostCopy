# -----------------------------------------------------------------
# green/white team positions - playing left to right

robot robot3
mvrp 2700 1000 530 0 0 180

robot robot4
mvrp 0 1500 530 0 0 180

robot robot5
mvrp -400 2300 530 0 0 180


# -----------------------------------------------------------------
# red/blue team positions
robot robot21
mvrp -4300 0 530 0 0 0

robot robot22
mvrp -2300 -1100 530 0 0 0

robot robot23
mvrp 2200 500 530 0 0 0

robot robot24
mvrp -300 -300 530 0 0 115

# robot robot25
# mvrp -800 -2000 530 0 0 0

# -----------------------------------------------------------------
# move the ball in front to robot24
mvb -450 100 1000

# -----------------------------------------------------------------

# -----------------------------------------------------------------
# Set GameState for Set Play
robot all
gc gameNormal
gc set

echo 
