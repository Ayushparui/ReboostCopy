<Simulation>

  <Include href="../../Includes/NaoV6H25.rsi3"/>
  <Include href="../../Includes/Ball2016SPL.rsi3"/>
  <Include href="../../Includes/Field2020SPL.rsi3"/>

  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.012" color="rgb(65%, 65%, 70%)">
    <PointLight z="9m" ambientColor="rgb(50%, 50%, 50%)"/>

    <Compound name="teams">
      <Compound name="RoboEireann">
        <Compound name="17"/>
        <Compound name="green"/>
        <Compound name="white"/>
      </Compound>
      <Compound name="B-Team">
        <Compound name="70"/>
        <Compound name="red"/>
        <Compound name="blue"/>
      </Compound>
    </Compound>

    <Compound name="robots">
      <Body ref="Nao" name="robot5">
        <Translation x="3200mm" y="-3150mm" z="320mm"/>
        <Rotation z="90degree"/>
        <Set name="TeamColor" value="green"/>
      </Body>
    </Compound>

    <Compound name="extras">
      <Body ref="NaoDummy" name="robot21">
        <Translation x="3200mm" y="0mm" z="320mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>
      <Body ref="NaoDummy" name="robot22">
        <Translation x="3900mm" y="-1100mm" z="320mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>
      <Body ref="NaoDummy" name="robot23">
        <Translation x="3900mm" y="1100mm" z="320mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>
      <Body ref="NaoDummy" name="robot24">
        <Translation x="2850mm" y="-2000mm" z="320mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>
    </Compound>

    <!-- ball out of sight near end line -->
    <!--
    <Compound name="balls">
      <Body ref="ball">
        <Translation x="4300mm" y="2800mm" z="1m"/>
      </Body>
    </Compound>
    -->

    <Compound ref="field"/>

    <Compound name="location">
      <Compound name="RE-Nao/RC2025"/>
    </Compound>
    <Compound name="scenarios">
      <Compound name="RE-Nao/RC2025-FastestWalk"/>
    </Compound>

  </Scene>
</Simulation>
